# IPP AI Training Lab Environment Configuration
# Developed by Shunpei Suzuki (IPP) <suzuki.shunpei@ipp.local>

# 1. Vertex AI Express Mode (Recommended for workshop):
# Obtain key starting with AQ... from Google Cloud Console (Vertex AI Studio)
GOOGLE_API_KEY=AQ.your_vertex_ai_express_key_here
GOOGLE_CLOUD_PROJECT=your-gcp-project-id  # e.g. ipp-ai-training-lab
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# 2. Alternatively, for Gemini API via Google AI Studio:
# GEMINI_API_KEY=AIzaSy...
